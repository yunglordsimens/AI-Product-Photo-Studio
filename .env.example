# Server-side only (Vercel → Project → Settings → Environment Variables).
# Never prefix these with VITE_: anything with VITE_ is baked into the public bundle.

# Google AI Studio key used by the private proxy /api/gemini
GEMINI_API_KEY="your-gemini-key"

# Password you type once in the app settings to use the proxy (and the cloud)
STUDIO_PASSWORD="choose-a-long-password"

# Cloud (/api/cloud): documents in Neon Postgres, photos in Cloudflare R2
# DATABASE_URL is added by the Neon integration in Vercel (POSTGRES_URL also works)
DATABASE_URL="postgres://..."
R2_ACCOUNT_ID="cloudflare-account-id"
R2_ACCESS_KEY_ID="r2-token-access-key-id"
R2_SECRET_ACCESS_KEY="r2-token-secret"
R2_BUCKET="ofst-photo"
